[Unit]
Description=Minecraft Server (PaperMC)
After=network-online.target minecraft-configurator.service
Wants=network-online.target

[Service]
Type=simple
User=minecraft
WorkingDirectory=/opt/minecraft
ExecStart=/opt/minecraft/start-server.sh
ExecStop=/bin/kill -SIGINT $MAINPID
Restart=on-failure
RestartSec=30
TimeoutStopSec=120
StartLimitBurst=5
StartLimitIntervalSec=300

[Install]
WantedBy=multi-user.target
