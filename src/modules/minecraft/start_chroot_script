#!/usr/bin/env bash
#### minecraft — Minecraft server (PaperMC)
####
#### YumiOS Minecraft — serveur Minecraft pour SmartPi One (armhf)
####

# shellcheck enable=require-variable-braces
set -Ee
export LC_ALL=C
export DEBIAN_FRONTEND=noninteractive

# shellcheck disable=SC1091
source /common.sh
install_cleanup_trap

echo_green "Installing Minecraft server ..."

unpack /filesystem/root /

apt-get update --allow-releaseinfo-change

# Dépendances de base
# shellcheck disable=SC2086
check_install_pkgs wget curl python3

# Java 21 (Liberica JRE, BellSoft) est pré-installé par le CI dans /opt/java.
# Seule distribution Java 21 LTS disponible pour armhf 32-bit (Temurin/openjdk n'ont pas de build armhf).
ln -sf /opt/java/bin/java /usr/local/bin/java

# Créer l'utilisateur minecraft
useradd -r -m -d /opt/minecraft -s /bin/bash minecraft

# Générer server.env avec les variables de config et flags Aikar (G1GC, adapté 700M heap)
cat > /opt/minecraft/server.env << MCEOF
# YumiOS Minecraft — variables serveur (généré au build)
MC_VERSION="1.21.4"
MINECRAFT_XMS="${MINECRAFT_XMS}"
MINECRAFT_XMX="${MINECRAFT_XMX}"
JVM_FLAGS="-XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC -XX:G1NewSizePercent=30 -XX:G1MaxNewSizePercent=40 -XX:G1HeapRegionSize=8M -XX:G1ReservePercent=20 -XX:G1MixedGCCountTarget=4 -XX:InitiatingHeapOccupancyPercent=15 -XX:G1MixedGCLiveThresholdPercent=90 -XX:G1RSetUpdatingPauseTimePercent=5 -XX:SurvivorRatio=32 -XX:+PerfDisableSharedMem -XX:MaxTenuringThreshold=1 -Dusing.aikars.flags=https://mcflags.emc.gs -Daikars.new.flags=true"
MCEOF

# Swap 1GB pour stabiliser le GC Java (SmartPi One 1GB DDR3)
# Utilise /var/swap (pas /swapfile) : en chroot, mkswap compare les chemins
# dans /proc/swaps (bind-monté depuis le host CI). Si le host a /swapfile actif,
# mkswap refuse de formater même si c'est un fichier différent sur un autre FS.
if [ ! -f /var/swap ]; then
    fallocate -l 1G /var/swap
    chmod 600 /var/swap
    mkswap /var/swap
fi
if ! grep -q '/var/swap' /etc/fstab; then
    echo '/var/swap none swap sw 0 0' >> /etc/fstab
fi

# Tuning I/O pour SD card
cat > /etc/sysctl.d/99-minecraft.conf << SYSEOF
vm.swappiness=10
vm.vfs_cache_pressure=50
SYSEOF

# Télécharger PaperMC pendant le build (pas au premier boot)
MC_VERSION="1.21.4"
echo_green "Downloading PaperMC ${MC_VERSION} ..."
PAPER_BUILD=$(curl -sf "https://api.papermc.io/v2/projects/paper/versions/${MC_VERSION}/builds" \
    | python3 -c "import sys,json; builds=json.load(sys.stdin)['builds']; print(builds[-1]['build'])")
wget --tries=5 --retry-on-http-error=502,503,504 -q -O /opt/minecraft/server.jar \
    "https://api.papermc.io/v2/projects/paper/versions/${MC_VERSION}/builds/${PAPER_BUILD}/downloads/paper-${MC_VERSION}-${PAPER_BUILD}.jar"
echo "eula=true" > /opt/minecraft/eula.txt
echo_green "PaperMC ${MC_VERSION} build ${PAPER_BUILD} downloaded."

# Copier le template de config boot
if [ -f /boot/minecraft-config.txt.template ]; then
    cp /boot/minecraft-config.txt.template /boot/minecraft-config.txt
fi

# Rendre le configurateur exécutable
chmod +x /usr/local/bin/minecraft-configurator

# Permissions
chown -R minecraft:minecraft /opt/minecraft
chmod +x /opt/minecraft/start-server.sh

# Activer les services
systemctl_if_exists enable minecraft.service
systemctl_if_exists enable minecraft-configurator.service

echo_green "Installing Minecraft server ... [DONE]"
