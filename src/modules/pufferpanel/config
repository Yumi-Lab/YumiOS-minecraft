#!/usr/bin/env bash
# shellcheck disable=SC2034

# PufferPanel — panel web de management serveur Minecraft
# Binaire cross-compilé pour armhf pendant le build CI

[ -n "${PUFFERPANEL_PORT}" ]     || PUFFERPANEL_PORT="8080"
[ -n "${PUFFERPANEL_SFTP_PORT}" ] || PUFFERPANEL_SFTP_PORT="5657"
[ -n "${PUFFERPANEL_ADMIN_USER}" ] || PUFFERPANEL_ADMIN_USER="admin"
[ -n "${PUFFERPANEL_ADMIN_PASS}" ] || PUFFERPANEL_ADMIN_PASS="yumi"

# Pas de dépendances apt supplémentaires (binaire Go statique)
[ -n "${MODULE_DEPS}" ]          || MODULE_DEPS=""
